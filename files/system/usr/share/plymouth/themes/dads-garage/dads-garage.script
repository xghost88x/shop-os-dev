Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
scale = Window.GetWidth() / 960;
if (Window.GetHeight() / 540 < scale) scale = Window.GetHeight() / 540;
for (i = 0; i < 100; i++) {
    frames[i] = Image("frame-" + i + ".png");
    frames[i] = frames[i].Scale(960 * scale, 540 * scale);
}
scene = Sprite(frames[0]);
scene.SetX(Window.GetX() + (Window.GetWidth() - 960 * scale) / 2);
scene.SetY(Window.GetY() + (Window.GetHeight() - 540 * scale) / 2);
scene.SetZ(-10);
elapsed = 0;
mode = "normal";
prompt_sprite = Sprite();
prompt_sprite.SetZ(100);
fun show_text(text) {
    image = Image.Text(text, 0.9, 0.9, 0.9);
    prompt_sprite.SetImage(image);
    prompt_sprite.SetX(Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2);
    prompt_sprite.SetY(Window.GetY() + Window.GetHeight() * 0.87);
    prompt_sprite.SetOpacity(1);
}
fun refresh() {
    if (mode == "normal") {
        elapsed += 1.0 / 30;
        index = Math.Int(elapsed * 20);
        if (index > 99) index = 99;
        scene.SetImage(frames[index]);
    }
}
fun password(prompt, bullets) {
    mode = "password";
    scene.SetOpacity(0.2);
    stars = "";
    for (j = 0; j < bullets; j++) stars += "*";
    show_text(prompt + " " + stars);
}
fun question(prompt, entry) {
    mode = "question";
    scene.SetOpacity(0.2);
    show_text(prompt + " " + entry);
}
fun normal() {
    mode = "normal";
    scene.SetOpacity(1);
    prompt_sprite.SetOpacity(0);
}
fun message(text) { show_text(text); }
Plymouth.SetRefreshFunction(refresh);
Plymouth.SetDisplayPasswordFunction(password);
Plymouth.SetDisplayQuestionFunction(question);
Plymouth.SetDisplayNormalFunction(normal);
Plymouth.SetMessageFunction(message);
